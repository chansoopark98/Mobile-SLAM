cmake_minimum_required(VERSION 3.14)
project(native_audit_sanitizer LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_BUILD_TYPE Debug)
set(CMAKE_CXX_FLAGS_DEBUG "-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer")
set(CMAKE_EXE_LINKER_FLAGS "-fsanitize=address,undefined")
add_compile_definitions(EIGEN_FAST_MATH=0 EIGEN_DONT_VECTORIZE=1 EIGEN_DISABLE_UNALIGNED_ARRAY_ASSERT=1)
find_package(Eigen3 REQUIRED)
find_package(OpenCV REQUIRED)
find_package(yaml-cpp REQUIRED)
find_package(Threads REQUIRED)
set(ROOT "/home/park-ubuntu/park/SOLUTION/Mobile-SLAM")
add_library(gtest STATIC IMPORTED)
set_target_properties(gtest PROPERTIES IMPORTED_LOCATION "${ROOT}/build/audit-native/lib/libgtest.a" INTERFACE_INCLUDE_DIRECTORIES "${ROOT}/build/_deps/googletest-src/googletest/include")
add_library(gtest_main STATIC IMPORTED)
set_target_properties(gtest_main PROPERTIES IMPORTED_LOCATION "${ROOT}/build/audit-native/lib/libgtest_main.a")
add_library(audit_utility ${ROOT}/src/utility/config.cpp ${ROOT}/src/utility/utility.cpp)
target_link_libraries(audit_utility PUBLIC Eigen3::Eigen yaml-cpp)
target_include_directories(audit_utility PUBLIC ${ROOT}/include ${OpenCV_INCLUDE_DIRS})
add_executable(test_integration_base ${ROOT}/tests/test_integration_base.cpp)
target_link_libraries(test_integration_base audit_utility gtest_main gtest Threads::Threads)
add_executable(test_sliding_window ${ROOT}/tests/test_sliding_window.cpp ${ROOT}/src/backend/sliding_window.cpp ${ROOT}/src/common/frame.cpp)
target_link_libraries(test_sliding_window audit_utility gtest_main gtest Threads::Threads)
add_executable(test_trajectory_evaluator ${ROOT}/tests/test_trajectory_evaluator.cpp ${ROOT}/src/utility/trajectory_evaluator.cpp)
target_include_directories(test_trajectory_evaluator PRIVATE ${ROOT}/include)
target_link_libraries(test_trajectory_evaluator Eigen3::Eigen gtest_main gtest Threads::Threads)
enable_testing()
add_test(NAME IntegrationBaseSanitizer COMMAND test_integration_base)
add_test(NAME SlidingWindowSanitizer COMMAND test_sliding_window)
add_test(NAME TrajectoryEvaluatorSanitizer COMMAND test_trajectory_evaluator)
